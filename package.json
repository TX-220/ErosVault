{
  "name": "erosvault",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "pnpm run build:electron && concurrently -n TSC,NEXT,ELECTRON -c magenta,cyan,yellow \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"next dev -p 3002\" \"wait-on http://localhost:3002 dist-electron/main/main.js && electron . --no-sandbox\"",
    "build": "tsc -p tsconfig.electron.json && next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "start": "electron . --no-sandbox",
    "scheduler": "node dist-electron/headless/daemon.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "electron-serve": "^3.0.1",
    "next": "14.2.35",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/node-cron": "^3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.7.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.erosvault.desktop",
    "productName": "ErosVault",
    "files": [
      "dist-electron/**/*",
      "out/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
